# Copy to .env.local for development. In production these are wrangler
# secrets / vars (PUBLIC_POCKETBASE_URL is a var, PB_ADMIN_* are secrets).

# PocketBase origin. Browser and server both use it (no /api suffix).
# Prod: https://pocketbase.clockworkalchemy.info (set in wrangler.jsonc vars).
PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# Superuser the server uses to create transactional_emails rows. Must match
# the pair packages/database's init migration seeded for the same stage.
PB_ADMIN_USERNAME=you@example.com
PB_ADMIN_PASSWORD=atleast10chars
