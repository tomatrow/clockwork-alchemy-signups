# Copy to .env.local (shared) / .env.development.local / .env.production.local.
# Values here are baked into pb_data/data.db at `pocketbase migrate up` time by
# pb_migrations/*_init_schema.js — NOT read at PocketBase runtime.

# Origin of the SvelteKit app. Lands in settings.meta.appURL and in every auth
# email template. deploy.fish aborts if the prod value points at localhost.
PB_APP_URL=http://localhost:5173

# Transactional email (SMTP). Postmark today; swap host/user when that changes.
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- deploy.fish only (put these in .env.production.local) ---
# Coolify host to ssh/rsync into, e.g. deploy@pb.example.com
DEPLOY_PB_HOST=
# Coolify resource UUID; names the docker volumes
#   <uuid>_pocketbase-data / <uuid>_pocketbase-hooks
DEPLOY_PB_UUID=
