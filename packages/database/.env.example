# Copy to .env.local (stage-independent) / .env.development.local /
# .env.production.local.
# Values here are baked into pb_data/data.db at `pocketbase migrate up` time by
# pb_migrations/*_init_schema.js — NOT read at PocketBase runtime.
#
# WHICH FILE MATTERS. start.fish sources .env.local + .env.development.local;
# deploy.fish sources .env.local + .env.production.local. Anything stage-specific
# — above all PB_ADMIN_* — must go in the per-stage file, never in .env.local, or
# the dev value gets baked into prod's data.db.

# --- per-stage ---

# Origin of the SvelteKit app. Lands in settings.meta.appURL and in every auth
# email template. deploy.fish aborts if the prod value points at localhost.
PB_APP_URL=http://localhost:5173

# Superuser, seeded by the init migration into _superusers. This is the admin UI
# login at http://127.0.0.1:8090/_/ and, since pocketbase-typegen authenticates
# as a superuser, the typegen identity too — mirror the same values into
# packages/scripts/.env.<same stage>.local.
#
# Username is an email address (PocketBase requires one). Password must be >= 10
# chars; the migration throws early if it isn't.
#
# Unset is non-fatal: the migration skips the seed and PocketBase prints its
# one-time installer link on serve. deploy.fish, however, ABORTS on unset — a
# prod database with no reachable admin is a broken deploy. Use a distinct pair
# in .env.production.local.
PB_ADMIN_USERNAME=you@example.com
PB_ADMIN_PASSWORD=atleast10chars

# --- stage-independent (.env.local is fine) ---

# Transactional email: Cloudflare Email Service authenticated SMTP.
# https://developers.cloudflare.com/email-service/examples/email-sending/smtp/
# Username is the literal string "api_token"; password is a Cloudflare API
# token with the "Email Sending: Edit" permission. The sender domain must be
# onboarded for Email Sending on the account that owns the token.
# All three of SMTP_HOST / SMTP_PASSWORD / PB_SENDER_ADDRESS must be set or
# the migration leaves SMTP disabled and mail logs to the console.
SMTP_HOST=smtp.mx.cloudflare.net
SMTP_PORT=465
SMTP_USERNAME=api_token
SMTP_PASSWORD=
PB_SENDER_ADDRESS=
PB_SENDER_NAME=Clockwork Alchemy Workshops

# --- deploy.fish only (put these in .env.production.local) ---
# Coolify host to ssh/rsync into, e.g. deploy@pb.example.com
DEPLOY_PB_HOST=
# Coolify resource UUID; names the docker volumes
#   <uuid>_pocketbase-data / <uuid>_pocketbase-hooks
DEPLOY_PB_UUID=
