{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	// pb_data/types.d.ts is generated by PocketBase on first boot and supplies the
	// JSVM globals (onRecordsListRequest, $app, $os, ...). It is gitignored, so on a
	// fresh clone hook typechecking fails until `pnpm --filter database serve` has run once.
	"include": ["src/**/*.ts", "tsdown.config.ts", "pb_data/types.d.ts"]
}
