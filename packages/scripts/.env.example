# Copy to packages/scripts/.env.development.local (and .env.production.local if
# you ever typegen against prod). Only the scripts in this package read these —
# the database's own env (baked into data.db at migrate time) lives in
# packages/database/.env.*.local.
#
# generate-pb-types.fish reads .env.local + .env.<stage>.local, where stage is
# development unless PB_ENV=production.

# pocketbase-typegen reads the schema over the API, so it needs a RUNNING
# instance...
PB_TYPEGEN_URL=http://127.0.0.1:8090

# ...and logs in as a superuser. This is the SAME pair the init migration seeds
# into _superusers, duplicated here because the two packages don't read each
# other's env files. Keep them in sync per stage: if they diverge, typegen
# authenticates against an account that doesn't exist and 400s.
PB_ADMIN_USERNAME=you@example.com
PB_ADMIN_PASSWORD=atleast10chars
